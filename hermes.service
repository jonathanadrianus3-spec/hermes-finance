[Unit]
Description=Hermes Finance Telegram Bot & BCA Review Daemon
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/Hermes
ExecStart=/usr/bin/python3 /root/Hermes/main_bot.py
Restart=always
RestartSec=10
EnvironmentFile=/root/Hermes/.env

[Install]
WantedBy=multi-user.target
