# ================================================================
# HERMES TELEGRAM BOT & BCA EXPENSE AGENT CONFIGURATION
# ================================================================

# 1. Telegram Bot Credentials
# Get token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Send /start to your bot, it will output your Chat ID. Put it here:
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# 2. Gmail Automated Sync (For 20:55 daily BCA sync & on-demand /sync)
# Generate an App Password at: https://myaccount.google.com/apppasswords
EMAIL_HOST=imap.gmail.com
EMAIL_PORT=993
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_16_character_gmail_app_password
EMAIL_FOLDER=INBOX

# 3. Schedule Settings (24h format)
SYNC_TIME=20:55
REVIEW_TIME=21:00

# 4. Database Path
DATABASE_PATH=backend/db/hermes_finance.db
